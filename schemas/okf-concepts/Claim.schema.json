{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "const": "Claim"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "truth_state": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array"
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "factual",
        "numeric",
        "definitional",
        "predictive",
        "causal"
      ]
    },
    "claim_key": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
