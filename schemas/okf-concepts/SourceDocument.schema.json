{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SourceDocument.schema.json",
  "title": "SourceDocument",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "const": "SourceDocument"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "truth_state": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array"
    },
    "source_hash": {
      "type": "string"
    },
    "asset_path": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_filename": {
      "type": "string"
    },
    "origin_path": {
      "type": "string",
      "description": "Absolute path of the file as ingested. Distinguishes repeated basenames such as index.md."
    },
    "ingest_version": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "description": "URLs the source cites, in first-seen order. rkc_ingest writes it. ref is the entry number in a numbered source list.",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "ref": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
